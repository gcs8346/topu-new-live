import streamlit as st
import requests
import pandas as pd
import time

# पेज सेटअप
st.set_page_config(page_title="Upstox Gamma-Theta Live Scanner", layout="wide")
st.title("⚡ Upstox लाइव एक्सपायरी Gamma-Theta & OI डैशबोर्ड")

# साइडबार में Upstox API और एक्सपायरी की जानकारी
st.sidebar.header("🔑 Upstox सेटिंग्स")
access_token = st.sidebar.text_input("Upstox Access Token डालें:", type="password")
index_choice = st.sidebar.selectbox("इंडेक्स चुनें:", ["NSE_INDEX|Nifty 50", "NSE_INDEX|Nifty Bank", "NSE_INDEX|Nifty Fin Service"])
expiry_date = st.sidebar.text_input("एक्सपायरी डेट (YYYY-MM-DD):", value="2026-11-19")
auto_refresh = st.sidebar.checkbox("हर 5 सेकंड में लाइव रिफ्रेश करें", value=False)

# Upstox Option Chain API से लाइव डेटा लाने का फंक्शन
def fetch_upstox_option_chain(token, instrument_key, expiry):
    url = "https://api.upstox.com/v2/option/chain"
    params = {
        "instrument_key": instrument_key,
        "expiry_date": expiry
    }
    headers = {
        "Accept": "application/json",
        "Authorization": f"Bearer {token}"
    }
    response = requests.get(url, params=params, headers=headers)
    if response.status_code == 200:
        return response.json().get("data", [])
    else:
        st.error(f"API Error: {response.status_code} - कृपया अपना Access Token और Expiry Date जांचें।")
        return []

# डेटा प्रोसेस करने और सिग्नल बनाने का फंक्शन
def analyze_options(raw_data):
    rows = []
    spot_price = 0
    
    for item in raw_data:
        spot_price = item.get("underlying_spot_price", 0)
        strike = item.get("strike_price", 0)
        
        # स्पॉट प्राइस के आसपास की 10 स्ट्राइक (5 ऊपर, 5 नीचे) ही फिल्टर करें
        if abs(spot_price - strike) > 500:
            continue
            
        for opt_type, key in [("CE", "call_options"), ("PE", "put_options")]:
            opt = item.get(key, {})
            mkt = opt.get("market_data", {})
            greeks = opt.get("option_greeks", {})
            
            ltp = mkt.get("ltp", 0)
            close_p = mkt.get("close_price", 0)
            vol = mkt.get("volume", 0)
            oi = mkt.get("oi", 0)
            prev_oi = mkt.get("prev_oi", 0)
            oi_change = oi - prev_oi
            
            delta = round(greeks.get("delta", 0), 2)
            gamma = round(greeks.get("gamma", 0), 4)
            theta = round(greeks.get("theta", 0), 2)
            
            # --- सिग्नल लॉजिक (आपकी शर्तें) ---
            # 1. डेल्टा स्वीट स्पॉट (0.30 से 0.55)
            cond_delta = 0.30 <= abs(delta) <= 0.55
            # 2. शॉर्ट कवरिंग (OI घट रहा है)
            cond_oi = oi_change < 0
            # 3. हाई वॉल्यूम और कीमत दिन के क्लोज/पिछले लेवल से ऊपर
            cond_momentum = (vol > 100000) and (ltp > close_p)
            
            if cond_delta and cond_oi and cond_momentum:
                signal = f"🔥 GAMMA BLAST BUY ({opt_type})"
            elif oi_change > 50000 and ltp < close_p:
                signal = "⚠️ AVOID (Theta Decay)"
            else:
                signal = "⏳ WAIT"
                
            rows.append({
                "Type": opt_type,
                "Strike": strike,
                "LTP (₹)": ltp,
                "Delta": delta,
                "Gamma": gamma,
                "Theta": theta,
                "Volume": vol,
                "OI Change": oi_change,
                "SIGNAL": signal
            })
            
    return pd.DataFrame(rows), spot_price

# रंगीन हाइलाइटिंग
def highlight_signal(val):
    if "GAMMA BLAST" in str(val):
        return 'background-color: #1b5e20; color: white; font-weight: bold;'
    elif "AVOID" in str(val):
        return 'background-color: #b71c1c; color: white;'
    return ''

# मुख्य स्क्रीन लॉजिक
if not access_token:
    st.warning("👈 शुरू करने के लिए बाईं तरफ (Sidebar) अपना **Upstox Access Token** और सही **Expiry Date** डालें।")
else:
    placeholder = st.empty()
    while True:
        with placeholder.container():
            raw_data = fetch_upstox_option_chain(access_token, index_choice, expiry_date)
            if raw_data:
                df, spot = analyze_options(raw_data)
                st.subheader(f"📊 स्पॉट प्राइस: {spot} | अपडेट समय: {time.strftime('%H:%M:%S')}")
                
                # कॉल और पुट को अलग-अलग दिखाएं
                col1, col2 = st.columns(2)
                with col1:
                    st.markdown("### 🟢 CALL Options (CE)")
                    ce_df = df[df["Type"] == "CE"].drop(columns=["Type"])
                    st.dataframe(ce_df.style.applymap(highlight_signal, subset=['SIGNAL']), use_container_width=True)
                with col2:
                    st.markdown("### 🔴 PUT Options (PE)")
                    pe_df = df[df["Type"] == "PE"].drop(columns=["Type"])
                    st.dataframe(pe_df.style.applymap(highlight_signal, subset=['SIGNAL']), use_container_width=True)
                    
        if not auto_refresh:
            break
        time.sleep(5)