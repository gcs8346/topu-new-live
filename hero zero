# Upstox Option Chain API से लाइव डेटा लाने का फंक्शन
def fetch_upstox_option_chain(token, instrument_key, expiry):
    url = "https://upstox.com"
    params = {
        "instrument_key": instrument_key,
        "expiry_date": expiry
    }
    headers = {
        "Accept": "application/json",
        "Authorization": f"Bearer {token}"
    }
    try:
        response = requests.get(url, params=params, headers=headers)
        if response.status_code == 200:
            return response.json().get("data", [])
        else:
            st.error(f"API Error: {response.status_code} - कृपया अपना Access Token और Expiry Date जांचें।")
            return []
    except Exception as e:
        st.error(f"कनेक्शन एरर: {e}")
        return []

# डेटा प्रोसेस करने और सिग्नल बनाने का फंक्शन
def analyze_options(raw_data, selected_index, target_expiry):
    rows = []
    spot_price = 0
    
    # 1. ऑटोमैटिक दिन डिटेक्ट करने का लॉजिक
    today_str = datetime.today().strftime('%Y-%m-%d')
    is_expiry_day = (today_str == target_expiry)
    
    # इंडेक्स के हिसाब से रेंज
    filter_range = 1500 if "SENSEX" in selected_index else 500
    
    # 2. दिनों के हिसाब से डायनामिक कंडीशन सेट करना
    if is_expiry_day:
        min_volume = 100000       # एक्सपायरी के दिन भारी वॉल्यूम चाहिए
        min_oi_drop = 0          # OI घटना ही चाहिए (Short Covering)
        market_status_label = "🔴 EXPIRY DAY MODE (High Volume Filter)"
    else:
        min_volume = 30000        # नॉर्मल दिनों के लिए कम वॉल्यूम फ़िल्टर
        min_oi_drop = 5000       # यदि OI 5000 भी घटा, तो मोमेंटम मानेंगे
        market_status_label = "🔵 NORMAL DAY MODE (Low Volume Filter)"
    
    for item in raw_data:
        spot_price = item.get("underlying_spot_price", 0)
        strike = item.get("strike_price", 0)
        
        if abs(spot_price - strike) > filter_range:
            continue
            
        for opt_type, key in [("CE", "call_options"), ("PE", "put_options")]:
            opt = item.get(key, {})
            mkt = opt.get("market_data", {})
            greeks = opt.get("option_greeks", {})
            
            ltp = mkt.get("ltp", 0)
            close_p = mkt.get("close_price", 0)
            vol = mkt.get("volume", 0)
            oi = mkt.get("oi", 0)
            prev_oi = mkt.get("prev_oi", 0)
            oi_change = oi - prev_oi
            
            delta = round(greeks.get("delta", 0), 2)
            gamma = round(greeks.get("gamma", 0), 4)
            theta = round(greeks.get("theta", 0), 2)
            
            # --- डायनामिक सिग्नल लॉजिक ---
            cond_delta = 0.30 <= abs(delta) <= 0.55
            
            # नॉर्मल दिनों और एक्सपायरी के नियमों को यहाँ लागू किया गया है
            if is_expiry_day:
                cond_oi = oi_change < 0
                cond_momentum = (vol > min_volume) and (ltp > close_p)
            else:
                # नॉर्मल दिन में थोड़े कम OI ड्रॉप और कम वॉल्यूम पर भी सिग्नल बनेगा
                cond_oi = oi_change < -min_oi_drop or (oi_change < 0 and abs(oi_change) > (oi * 0.02))
                cond_momentum = (vol > min_volume) and (ltp > close_p)
            
            if cond_delta and cond_oi and cond_momentum:
                signal = f"🔥 GAMMA BLAST BUY ({opt_type})"
            elif oi_change > 50000 and ltp < close_p:
                signal = "⚠️ AVOID (Theta Decay)"
            else:
                signal = "⏳ WAIT"
                
            rows.append({
                "Type": opt_type,
                "Strike": strike,
                "LTP (₹)": ltp,
                "Delta": delta,
                "Gamma": gamma,
                "Theta": theta,
                "Volume": vol,
                "OI Change": oi_change,
                "SIGNAL": signal
            })
            
    return pd.DataFrame(rows), spot_price, market_status_label

# रंगीन हाइलाइटिंग
def highlight_signal(val):
    if "GAMMA BLAST" in str(val):
        return 'background-color: #1b5e20; color: white; font-weight: bold;'
    elif "AVOID" in str(val):
        return 'background-color: #b71c1c; color: white;'
    return ''

# मुख्य स्क्रीन लॉजिक
if not access_token:
